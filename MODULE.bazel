module(
    name = "bazelex",
    version = "0.0.0",
)

bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")
bazel_dep(name = "rules_go", version = "0.63.0", repo_name = "io_bazel_rules_go")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# buildtools' own BUILD files build build_proto from build.proto, which would
# compile protoc from source. Regenerate them and use the checked-in
# build.gen.pb.go as plain Go instead.
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable"],
    path = "github.com/bazel-contrib/buildtools/v10",
)

# Same for go-graphviz: use its checked-in generated protobuf code as plain Go.
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable"],
    path = "github.com/goccy/go-graphviz",
)
use_repo(
    go_deps,
    "com_github_bazel_contrib_buildtools_v10",
    "com_github_goccy_go_graphviz",
    "org_golang_google_protobuf",
    "org_modernc_sqlite",
)
