load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "bazelex_lib",
    srcs = ["main.go"],
    importpath = "github.com/vnasardinov/bazelex/cmd/bazelex",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/graphdb",
        "@org_modernc_sqlite//:sqlite",
    ],
)

go_binary(
    name = "bazelex",
    embed = [":bazelex_lib"],
    visibility = ["//visibility:public"],
)
