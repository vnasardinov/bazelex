load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "engine",
    srcs = [
        "datalog.go",
        "engine.go",
        "pkgraph.go",
    ],
    importpath = "github.com/vnasardinov/bazelex/internal/engine",
    visibility = ["//:__subpackages__"],
    deps = [
        "@com_github_google_mangle//analysis",
        "@com_github_google_mangle//ast",
        "@com_github_google_mangle//engine",
        "@com_github_google_mangle//factstore",
        "@com_github_google_mangle//parse",
    ],
)

go_test(
    name = "engine_test",
    srcs = [
        "datalog_test.go",
        "engine_test.go",
        "pkgraph_test.go",
    ],
    embed = [":engine"],
    deps = [
        "//internal/graphdb",
        "@com_github_google_mangle//ast",
        "@org_modernc_sqlite//:sqlite",
    ],
)
