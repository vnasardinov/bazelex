load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ui",
    srcs = [
        "graph.go",
        "queries.go",
        "server.go",
    ],
    embedsrcs = [
        "graph.html",
        "index.html",
    ],
    importpath = "github.com/vnasardinov/bazelex/internal/ui",
    visibility = ["//:__subpackages__"],
    deps = ["@com_github_goccy_go_graphviz//:go-graphviz"],
)

go_test(
    name = "ui_test",
    srcs = [
        "graph_test.go",
        "server_test.go",
    ],
    embed = [":ui"],
    deps = [
        "//internal/graphdb",
        "@org_modernc_sqlite//:sqlite",
    ],
)
